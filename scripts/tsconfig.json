{
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": false,
    "exactOptionalPropertyTypes": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    "outDir": "../dist-scripts",
    "rootDir": ".",
    "strict": true,
    "target": "ES2022"
  },
  "include": ["*.ts"],
  "references": [{ "path": "../packages/protocol" }]
}
